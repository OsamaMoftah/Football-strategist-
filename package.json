{
  "name": "football-strategist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/copy-ort.mjs && next dev",
    "build": "node scripts/copy-ort.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test:cv": "tsx --test src/lib/cv/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write src scripts next.config.ts eslint.config.mjs package.json",
    "format:check": "prettier --check src scripts next.config.ts eslint.config.mjs package.json",
    "verify:assets": "node scripts/verify-assets.mjs",
    "verify": "pnpm verify:assets && pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:cv && pnpm build"
  },
  "dependencies": {
    "lucide-react": "^1.61.0",
    "next": "16.4.3",
    "onnxruntime-web": "^1.30.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^6"
  },
  "packageManager": "pnpm@9.15.5",
  "description": "Football clip review with browser or native processing, ball tracking and evidence-linked review cues.",
  "license": "MIT",
  "engines": {
    "node": ">=22 <25"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/OsamaMoftah/Football-strategist-.git"
  }
}
